{
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@droidsolutions-oss/semantic-release-nuget": "^2.1.2",
    "@semantic-release/changelog": "github:semantic-release/changelog",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/git": "github:semantic-release/git",
    "husky": "^9.1.7",
    "semantic-release": "^25.0.9"
  },
  "release": {
    "branches": [
      "main",
      {
        "name": "beta",
        "prerelease": true
      }
    ],
    "plugins": [
      "@semantic-release/commit-analyzer",
      "@semantic-release/release-notes-generator",
      "@semantic-release/changelog",
      [
        "@droidsolutions-oss/semantic-release-nuget",
        {
          "includeSymbols": true,
          "projectPath": "src/Digitall.Plugins.Registration/Digitall.Plugins.Registration.csproj",
          "usePackageVersion": true
        }
      ],
      [
        "@semantic-release/exec",
        {
          "prepareCmd": "dotnet pack src/Digitall.Plugins.Registration.Source/Digitall.Plugins.Registration.Source.csproj -c Release -o out --no-restore -p:PackageVersion=${nextRelease.version}"
        }
      ],
      [
        "@semantic-release/git",
        {
          "assets": [
            "CHANGELOG.md"
          ],
          "message": "chore(release): ${nextRelease.version} [skip ci]\n\n${nextRelease.notes}"
        }
      ],
      "@semantic-release/github"
    ]
  },
  "scripts": {
    "prepare": "husky"
  }
}
