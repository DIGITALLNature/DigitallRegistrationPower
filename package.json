{
  "devDependencies": {
    "@commitlint/cli": "^21.0.2",
    "@commitlint/config-conventional": "^21.0.2",
    "@droidsolutions-oss/semantic-release-nuget": "^2.1.0",
    "@semantic-release/changelog": "github:semantic-release/changelog",
    "@semantic-release/git": "github:semantic-release/git",
    "husky": "^9.1.7",
    "semantic-release": "^25.0.3"
  },
  "release": {
    "branches": [
      "main",
      {
        "name": "beta",
        "prerelease": true
      }
    ],
    "plugins": [
      "@semantic-release/commit-analyzer",
      "@semantic-release/release-notes-generator",
      "@semantic-release/changelog",
      "@droidsolutions-oss/semantic-release-nuget",
      [
        "@semantic-release/git",
        {
          "assets": [
            "CHANGELOG.md"
          ],
          "message": "chore(release): ${nextRelease.version} [skip ci]\n\n${nextRelease.notes}"
        }
      ],
      "@semantic-release/github"
    ],
    "includeSymbols": true,
    "projectPath": "src/Digitall.Plugins.Registration/Digitall.Plugins.Registration.csproj",
    "npmPublish": false,
    "usePackageVersion": true
  },
  "scripts": {
    "prepare": "husky"
  }
}
